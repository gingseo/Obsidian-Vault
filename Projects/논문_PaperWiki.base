filters:
  and:
    - task != null
views:
  - type: table
    name: 전체 논문
    groupBy:
      property: year
      direction: ASC
    order:
      - file.name
      - title
      - year
      - venue
      - jcr_quartile
      - status
      - task
      - direction
      - paper_tags
      - source
  - type: table
    name: 해야할 것
    filters:
      and:
        - status == "to-do"
    order:
      - file.name
      - title
      - venue
      - year
      - source
  - type: table
    name: 진행 중
    filters:
      and:
        - status == "in-progress"
    order:
      - file.name
      - title
      - task
      - venue
      - year
  - type: table
    name: 추가 공부 요청
    filters:
      and:
        - status == "additional-study-needed"
    order:
      - file.name
      - title
      - task
      - venue
      - year
  - type: table
    name: 완료
    filters:
      and:
        - status == "done"
    order:
      - file.name
      - title
      - task
      - direction
      - venue
      - year
  - type: table
    name: Task별
    order:
      - task
      - file.name
      - title
      - direction
      - venue
      - year
  - type: table
    name: Small_Object_Detection (year)
    filters:
      and:
        - task.contains("small-object-detection")
    order:
      - file.name
      - title
      - year
      - status
      - direction
      - venue
    sort:
      - property: year
        direction: ASC
  - type: table
    name: Small_Object_Detection (venue)
    filters:
      and:
        - task.contains("small-object-detection")
    order:
      - file.name
      - title
      - venue
      - status
      - direction
      - year
    sort:
      - property: venue
        direction: ASC
  - type: table
    name: Anomaly_Detection (year)
    filters:
      and:
        - task.contains("anomaly-detection")
    order:
      - file.name
      - title
      - year
      - status
      - direction
      - venue
    sort:
      - property: year
        direction: ASC
  - type: table
    name: Anomaly_Detection (venue)
    filters:
      and:
        - task.contains("anomaly-detection")
    order:
      - file.name
      - title
      - venue
      - status
      - direction
      - year
    sort:
      - property: venue
        direction: ASC
  - type: table
    name: Instance_Segmentation (year)
    filters:
      and:
        - task.contains("instance-segmentation")
    order:
      - file.name
      - title
      - year
      - status
      - direction
      - venue
    sort:
      - property: year
        direction: ASC
  - type: table
    name: Instance_Segmentation (venue)
    filters:
      and:
        - task.contains("instance-segmentation")
    order:
      - file.name
      - title
      - venue
      - status
      - direction
      - year
    sort:
      - property: venue
        direction: ASC
  - type: table
    name: Salient_Object_Detection (year)
    filters:
      and:
        - task.contains("salient-object-detection")
    order:
      - file.name
      - title
      - year
      - status
      - direction
      - venue
    sort:
      - property: year
        direction: ASC
  - type: table
    name: Salient_Object_Detection (venue)
    filters:
      and:
        - task.contains("salient-object-detection")
    order:
      - file.name
      - title
      - venue
      - status
      - direction
      - year
    sort:
      - property: venue
        direction: ASC
  - type: table
    name: Visual_Grounding (year)
    filters:
      and:
        - task.contains("visual-grounding")
    order:
      - file.name
      - title
      - year
      - status
      - direction
      - venue
    sort:
      - property: year
        direction: ASC
  - type: table
    name: Visual_Grounding (venue)
    filters:
      and:
        - task.contains("visual-grounding")
    order:
      - file.name
      - title
      - venue
      - status
      - direction
      - year
    sort:
      - property: venue
        direction: ASC
  - type: table
    name: AI_Generated_Image_Detection (year)
    filters:
      and:
        - task.contains("ai-generated-image-detection")
    order:
      - file.name
      - title
      - year
      - status
      - direction
      - venue
    sort:
      - property: year
        direction: ASC
  - type: table
    name: AI_Generated_Image_Detection (venue)
    filters:
      and:
        - task.contains("ai-generated-image-detection")
    order:
      - file.name
      - title
      - venue
      - status
      - direction
      - year
    sort:
      - property: venue
        direction: ASC
  - type: table
    name: Q1만
    filters:
      and:
        - jcr_quartile == "Q1"
    order:
      - file.name
      - title
      - venue
      - jcr_quartile
      - task
      - year
  - type: table
    name: JCR 등급 확인 필요
    filters:
      and:
        - jcr_quartile == null
    order:
      - file.name
      - title
      - venue
      - task
      - year
